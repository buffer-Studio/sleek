# ==========================
# RUNTIME & LOGGING
# ==========================
NODE_ENV=development
LOG_LEVEL=debug
# Runtime mode: allInOne | gatewayOnly | workerOnly
SLEEK_RUNTIME_MODE=allInOne

# ==========================
# PLATFORM TOKENS
# ==========================
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=1526610796270981130
FLUXER_TOKEN=
FLUXER_API_BASE_URL=https://api.fluxer.app/v1

# ==========================
# DATA STORES (L2 VALKEY & L3 POSTGRESQL)
# ==========================
DATABASE_URL=
VALKEY_URL=

# ==========================
# HTTP INGRESS & WEBHOOKS
# ==========================
ENABLE_HTTP_INGRESS=false
HTTP_HOST=
HTTP_PORT=
TOPGG_WEBHOOK_AUTH=

# ==========================
# TELEMETRY & OBSERVABILITY
# ==========================
SENTRY_DSN=

# Platform-qualified Bot Owners & Dev Guilds (17-20 digit snowflakes)
DISCORD_BOT_OWNER_IDS=790846560229392444
FLUXER_BOT_OWNER_IDS=1472547187871686666
DISCORD_DEV_GUILD_ID=848179087562244117
FLUXER_DEV_GUILD_ID=1472551435787456552
ENABLE_DEV_SLASH_SYNC=false

# Operator Policy Config & Database Tuning
SLEEK_CONFIG_PATH=config/sleek.yaml
PG_POOL_MAX=10
PG_PREPARE=false
RUN_LIVE_INFRA_TESTS=0
SUPPORT_SERVER_URL=https://discord.gg/26MMXRHgZB
