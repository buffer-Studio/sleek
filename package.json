{
  "name": "sleek",
  "version": "0.1.0",
  "description": "Sleek application stack with Bun, tsrs, and TSDoc",
  "type": "module",
  "private": true,
  "license": "(AGPL-3.0-or-later OR GPL-3.0-or-later OR Apache-2.0)",
  "scripts": {
    "start": "bun run src/app/main.ts",
    "start:cluster": "bun run src/app/cluster/clusterManager.ts",
    "typecheck": "tsrs --noEmit --fast",
    "verify": "bun run .agents/scripts/verify-all.ts",
    "verify:ts": "bun run .agents/scripts/verify-all.ts --ts-only",
    "verify:staged": "bun run .agents/scripts/verify-staged.ts",
    "lint:boundaries": "bun run .agents/scripts/check-boundaries.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "build:native": "napi build --platform --release --manifest-path native/crates/sleek_napi/Cargo.toml -o native",
    "build:native:debug": "napi build --platform --manifest-path native/crates/sleek_napi/Cargo.toml -o native",
    "lint:style": "bun run .agents/scripts/check-gts.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "bun run .agents/scripts/clean.ts",
    "test": "bun test",
    "prepare": "git config core.hooksPath .agents/hooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.11.1",
    "@types/bun": "^1.4.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsrs": "^7.1.0-beta.tsrs5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "iovalkey": "^0.3.3",
    "lru-cache": "^11.1.0",
    "postgres": "^3.4.5",
    "yaml": "^2.7.1",
    "zod": "^4.6.7"
  }
}
